   SCRIPT COMPLET - Navigation par onglets
   ============================================================ */

// ── Custom cursor ──
const cursor = document.getElementById('cursor');
const ring   = document.getElementById('cursorRing');

if (cursor && ring && window.matchMedia('(hover: hover)').matches) {
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        cursor.style.left = mx + 'px';
        cursor.style.top = my + 'px';
    });
    (function lerp() {
        rx += (mx - rx) * 0.18;
        ry += (my - ry) * 0.18;
        ring.style.left = rx + 'px';
        ring.style.top = ry + 'px';
        requestAnimationFrame(lerp);
    })();

    document.querySelectorAll('a, button, .card, .project-card, .patrimoine-card, .skill-card').forEach(el => {
        el.addEventListener('mouseenter', () => {
            ring.style.width = '52px';
            ring.style.height = '52px';
            ring.style.borderColor = 'rgba(0,212,255,.9)';
        });
        el.addEventListener('mouseleave', () => {
            ring.style.width = '36px';
            ring.style.height = '36px';
            ring.style.borderColor = 'rgba(0,212,255,.6)';
        });
    });
}

// ── Particles canvas (hero) ──
const canvas = document.getElementById('particles');
let particlesRunning = false;

if (canvas) {
    const ctx = canvas.getContext('2d');
    let W, H, particles = [];

    function resize() {
        if (!canvas.parentElement) return;
        W = canvas.width = canvas.parentElement.offsetWidth;
        H = canvas.height = canvas.parentElement.offsetHeight;
    }

    function initParticles() {
        particles = [];
        for (let i = 0; i < 70; i++) {
            particles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                vx: (Math.random() - 0.5) * 0.3,
                vy: (Math.random() - 0.5) * 0.3,
                r: Math.random() * 2 + 0.5,
                a: Math.random()
            });
        }
    }

    function drawParticles() {
        if (!particlesRunning) return;
        ctx.clearRect(0, 0, W, H);
        particles.forEach(p => {
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0 || p.x > W) p.vx *= -1;
            if (p.y < 0 || p.y > H) p.vy *= -1;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(0,212,255,${p.a * 0.6})`;
            ctx.fill();
        });

        particles.forEach((a, i) => {
            particles.slice(i + 1).forEach(b => {
                const d = Math.hypot(a.x - b.x, a.y - b.y);
                if (d < 100) {
                    ctx.beginPath();
                    ctx.moveTo(a.x, a.y);
                    ctx.lineTo(b.x, b.y);
                    ctx.strokeStyle = `rgba(0,212,255,${0.15 * (1 - d / 100)})`;
                    ctx.lineWidth = 0.6;
                    ctx.stroke();
                }
            });
        });

        requestAnimationFrame(drawParticles);
    }

    function startParticles() {
        resize();
        initParticles();
        if (!particlesRunning) {
            particlesRunning = true;
            drawParticles();
        }
    }

    function stopParticles() {
        particlesRunning = false;
    }

    window.addEventListener('resize', () => {
        if (document.getElementById('accueil').classList.contains('active')) {
            resize();
            initParticles();
        }
    });

    // Démarrer/arrêter selon la section active
    window.__startParticles = startParticles;
    window.__stopParticles = stopParticles;
}

// ── Navigation par onglets ──
const navLinks = document.querySelectorAll('.nav-link');
const sections = document.querySelectorAll('.page-section');

function showSection(sectionId) {
    // Masquer toutes les sections
    sections.forEach(sec => sec.classList.remove('active'));
    // Désactiver tous les liens
    navLinks.forEach(l => l.classList.remove('active'));

    // Afficher la section demandée
    const target = document.getElementById(sectionId);
    const link = document.querySelector(`.nav-link[data-section="${sectionId}"]`);

    if (target) {
        target.classList.add('active');
        // Réinitialiser les animations des timelines
        target.querySelectorAll('.timeline-item').forEach((item, i) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
            setTimeout(() => {
                item.style.transition = 'opacity 0.5s, transform 0.5s';
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
            }, i * 120 + 100);
        });

        // Réinitialiser les progress-fill
        target.querySelectorAll('.progress-fill').forEach(bar => {
            bar.style.width = bar.dataset.width + '%';
        });
    }

    if (link) link.classList.add('active');

    // Scroll en haut
    window.scrollTo({ top: 0, behavior: 'smooth' });

    // Mémoriser l'onglet actif
    localStorage.setItem('activeSection', sectionId);

    // Gérer les particules
    if (sectionId === 'accueil' && window.__startParticles) {
        setTimeout(() => window.__startParticles(), 50);
    } else if (window.__stopParticles) {
        window.__stopParticles();
    }
}

navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
        e.preventDefault();
        const sectionId = link.dataset.section;
        showSection(sectionId);
        // Fermer le menu mobile
        const topbarNav = document.getElementById('topbar-nav');
        if (topbarNav) topbarNav.classList.remove('open');
    });
});

// Restaurer le dernier onglet visité au chargement
window.addEventListener('DOMContentLoaded', () => {
    const saved = localStorage.getItem('activeSection') || 'accueil';
    showSection(saved);
});

// ── Mobile hamburger ──
const hamburger = document.getElementById('hamburger');
const topbarNav = document.getElementById('topbar-nav');

if (hamburger && topbarNav) {
    hamburger.addEventListener('click', () => {
        topbarNav.classList.toggle('open');
    });
}

// ── Contact form toast ──
const form = document.getElementById('contactForm');
const toast = document.getElementById('toast');

if (form) {
    form.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = form.querySelector('button');
        btn.textContent = 'Envoi en cours…';
        btn.disabled = true;

        try {
            const res = await fetch(form.action, {
                method: 'POST',
                body: new FormData(form),
                headers: { Accept: 'application/json' }
            });
            if (res.ok) {
                form.reset();
                showToast('✅ Message envoyé avec succès !');
            } else {
                showToast('❌ Erreur, réessayez.');
            }
        } catch (err) {
            showToast('❌ Erreur réseau.');
        }
        btn.textContent = 'Envoyer le message';
        btn.disabled = false;
    });
}

function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3500);
}

// ── Slider Veille Technologique ──
const slides = document.querySelectorAll('.slide-card');
const prevBtn = document.getElementById('prev-slide');
const nextBtn = document.getElementById('next-slide');
const dots = document.querySelectorAll('.dot');

let currentSlide = 0;
const totalSlides = slides.length;

function showSlide(index) {
    if (totalSlides === 0) return;
    slides.forEach(slide => slide.classList.remove('active'));
    dots.forEach(dot => dot.classList.remove('active'));

    slides[index].classList.add('active');
    if (dots[index]) dots[index].classList.add('active');
    currentSlide = index;
}

function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    showSlide(currentSlide);
}

function prevSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(currentSlide);
}

if (prevBtn) prevBtn.addEventListener('click', prevSlide);
if (nextBtn) nextBtn.addEventListener('click', nextSlide);

if (dots.length > 0) {
    dots.forEach((dot, index) => {
        dot.addEventListener('click', () => showSlide(index));
    });
}

// ── Thème clair / sombre ──
const themeToggle = document.getElementById('theme-toggle');

if (themeToggle) {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
    } else {
        document.documentElement.removeAttribute('data-theme');
        themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
    }

    themeToggle.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme === 'dark') {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
            themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
            themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
        }
    });
}

// ── MODALE COMPÉTENCES ──
const modal = document.getElementById('skill-modal');
const modalTitle = document.getElementById('modal-title');
const modalDescription = document.getElementById('modal-description');
const closeBtn = document.querySelector('.modal-close');
const prevSkillBtn = document.getElementById('prev-skill');
const nextSkillBtn = document.getElementById('next-skill');
const currentIndexSpan = document.getElementById('current-skill-index');
const totalSkillsSpan = document.getElementById('total-skills');

const skillsList = [
    "Ticketing",
    "Virtualisation",
    "TCP/IP & Réseaux",
    "Cisco Packet Tracer",
    "Linux",
    "VScode"
];

const skillsContent = {
    "Ticketing": "J'ai appris à gérer et créer des tickets aussi bien en entreprise que durant les cours, notamment via l'outil GLPI. Aujourd'hui, je sais suivre un ticket du début à la résolution et assurer un support utilisateur organisé.",
    "Virtualisation": "La virtualisation fait partie de ma formation en BTS, avec des outils comme VMware et VirtualBox, ce qui me permet de créer et gérer des machines virtuelles pour tester différentes configurations réseaux et systèmes.",
    "TCP/IP & Réseaux": "J'ai acquis les bases solides du réseau (modèle TCP/IP, routage, VLAN, adressage IP…) en cours. Cela me permet de comprendre et configurer des environnements réseau simples à intermédiaires.",
    "Cisco Packet Tracer": "J'ai réalisé de nombreux TP avec Cisco Packet Tracer. Cela m'a permis de simuler des architectures réseau, configurer des équipements Cisco et renforcer ma compréhension du fonctionnement d'un réseau.",
    "Linux": "Je suis familier avec l'environnement Linux (Ubuntu/Debian), les commandes essentielles, l'administration système, la gestion des droits, des paquets et des services.",
    "VScode": "VSCode est mon éditeur de référence aussi bien pour mes projets personnels, mes cours que certaines tâches professionnelles. Je l'utilise pour coder, organiser mes projets et travailler avec différentes extensions."
};

let currentSkillIndex = 0;
const totalSkills = skillsList.length;

if (totalSkillsSpan) totalSkillsSpan.textContent = totalSkills;

function showSkill(index) {
    if (index < 0) index = 0;
    if (index >= totalSkills) index = totalSkills - 1;

    currentSkillIndex = index;
    const skillName = skillsList[currentSkillIndex];

    if (modalTitle) modalTitle.textContent = skillName;
    if (modalDescription) modalDescription.textContent = skillsContent[skillName] || "Description détaillée à venir.";
    if (currentIndexSpan) currentIndexSpan.textContent = currentSkillIndex + 1;
}

document.querySelectorAll('.skill-link').forEach(link => {
    link.addEventListener('click', (e) => {
        e.preventDefault();
        const skillName = link.getAttribute('data-skill');
        const foundIndex = skillsList.indexOf(skillName);
        currentSkillIndex = foundIndex !== -1 ? foundIndex : 0;
        showSkill(currentSkillIndex);
        if (modal) modal.style.display = 'flex';
    });
});

if (prevSkillBtn) {
    prevSkillBtn.addEventListener('click', () => showSkill(currentSkillIndex - 1));
}

if (nextSkillBtn) {
    nextSkillBtn.addEventListener('click', () => showSkill(currentSkillIndex + 1));
}

if (closeBtn) {
    closeBtn.addEventListener('click', () => {
        if (modal) modal.style.display = 'none';
    });
}

window.addEventListener('click', (e) => {
    if (e.target === modal && modal) {
        modal.style.display = 'none';
    }
});

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
        modal.style.display = 'none';
    }
    if (modal && modal.style.display === 'flex') {
        if (e.key === 'ArrowLeft') showSkill(currentSkillIndex - 1);
        else if (e.key === 'ArrowRight') showSkill(currentSkillIndex + 1);
    }
});
